APP_NAME=Distributed Document Intelligence
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Gemini is optional. Keep secrets only in .env.
GEMINI_API_KEY=
GEMINI_MODEL=

# Storage
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/docintel
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_PATH=data/processed/chunks.faiss
BM25_INDEX_PATH=data/processed/bm25_index.pkl
TOP_K_LEXICAL=100
TOP_K_VECTOR=100
RRF_K=60
