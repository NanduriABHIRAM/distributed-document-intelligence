APP_NAME=TraceRAG
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Gemini is optional. Keep secrets only in .env.
GEMINI_API_KEY=
GEMINI_MODEL=

# Grounded local RAG generation (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=bge-m3

# Storage
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/docintel
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_PATH=data/processed/chunks.faiss
BM25_INDEX_PATH=data/processed/bm25_index.pkl
TOP_K_LEXICAL=100
TOP_K_VECTOR=100
RRF_K=60

SPACY_MODEL=en_core_web_sm
# Set to a cross-encoder model name to enable optional reranking.
RERANKER_MODEL=
